{
  "name": "expense-echo",
  "version": "0.0.1",
  "description": "LINE 上的記帳 chatbot、跑在 Cloudflare 全家桶",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute expense-echo-db --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute expense-echo-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.78.0"
  },
  "license": "MIT"
}
